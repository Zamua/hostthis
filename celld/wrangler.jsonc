{
  // hostthis's celld application. ONE application per fleet: a second
  // `celld deploy` to the same bucket replaces this one, silently, so this
  // fleet's bucket is hostthis's alone (docs/design/celld-port-audit.md).
  "name": "hostthis",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITY", "class_name": "Identity" },
      { "name": "PASTES", "class_name": "Paste" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "SUBNETS", "class_name": "Subnet" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IntentLog", "Room"] },
    // Identity supersedes IntentLog: the cell owns the owner's quota and index
    // as well as its intents, so a create's first step is one atomic event.
    // `celld deploy` rejects renamed_classes, so this is a NEW class and
    // IntentLog stays declared as a stub to keep the v1 migration resolvable.
    // Intents written under the old class are stranded, which is acceptable
    // only because this is an experiment with disposable state.
    { "tag": "v2", "new_sqlite_classes": ["Identity", "Paste"] },
    { "tag": "v3", "new_sqlite_classes": ["Subnet"] }
  ]
}
