{
  "about": "Room value wire encoding, run by internal/domain (RoomWireValue, RoomValueIsJSON) and celld/test/room-wire.test.js, and as values written to a room by the live suites (internal/http TestLiveRoom, celld/test/rooms-live.test.js), which compare the whole-room GET with the frames. A vector's bytes are `in` as UTF-8, `hex`, or `nest` (open repeated depth times, then inner, then close repeated depth times). `json` is RoomValueIsJSON. A JSON value passes through: `wire` is exactly the text every surface emits, its bytes with each byte of an invalid UTF-8 sequence replaced by one U+FFFD (`wire` absent: the input itself). Anything else becomes a JSON string whose decoded `value` is given.",
  "vectors": [
    { "name": "object", "in": "{\"a\":1,\"b\":[true,null]}", "json": true, "wire": "{\"a\":1,\"b\":[true,null]}" },
    { "name": "object whitespace kept", "in": "{ \"a\" : 1 }", "json": true, "wire": "{ \"a\" : 1 }" },
    { "name": "surrounding whitespace kept", "in": " 1 \n", "json": true, "wire": " 1 \n" },
    { "name": "number", "in": "42", "json": true, "wire": "42" },
    { "name": "number with fraction and exponent", "in": "-1.5e+10", "json": true, "wire": "-1.5e+10" },
    { "name": "number beyond float64", "in": "1e400", "json": true, "wire": "1e400" },
    { "name": "integer beyond int64", "in": "12345678901234567890", "json": true, "wire": "12345678901234567890" },
    { "name": "negative zero", "in": "-0", "json": true, "wire": "-0" },
    { "name": "string", "in": "\"already a json string\"", "json": true, "wire": "\"already a json string\"" },
    { "name": "null", "in": "null", "json": true, "wire": "null" },
    { "name": "true", "in": "true", "json": true, "wire": "true" },
    { "name": "array", "in": "[1,2,3]", "json": true, "wire": "[1,2,3]" },
    { "name": "duplicate names", "in": "{\"a\":1,\"a\":2}", "json": true, "wire": "{\"a\":1,\"a\":2}" },
    { "name": "integer-like member name after another", "in": "{\"b\":1,\"1\":2}", "json": true, "wire": "{\"b\":1,\"1\":2}" },
    { "name": "whitespace inside nested values", "in": "[ 1 , { \"x\" : null } ]", "json": true, "wire": "[ 1 , { \"x\" : null } ]" },
    { "name": "exponent spelling", "in": "1E+2", "json": true, "wire": "1E+2" },
    { "name": "fraction with trailing zeros", "in": "1.50", "json": true, "wire": "1.50" },
    { "name": "escaped lone surrogate", "in": "\"\\ud800\"", "json": true, "wire": "\"\\ud800\"" },
    { "name": "every escape", "in": "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u00e9\"", "json": true, "wire": "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u00e9\"" },
    { "name": "invalid byte inside a string", "hex": "22ff22", "json": true, "wire": "\"\ufffd\"" },
    { "name": "truncated sequence inside a string", "hex": "22e28222", "json": true, "wire": "\"\ufffd\ufffd\"" },
    { "name": "invalid bytes between letters inside a string", "hex": "2261e282ff6222", "json": true, "wire": "\"a\ufffd\ufffd\ufffdb\"" },
    { "name": "invalid byte inside a member name", "hex": "7b22ff223a317d", "json": true, "wire": "{\"\ufffd\":1}" },
    { "name": "encoded surrogate inside a string", "hex": "22eda08022", "json": true, "wire": "\"\ufffd\ufffd\ufffd\"" },
    { "name": "arrays nested 10000 deep", "nest": { "open": "[", "inner": "", "close": "]", "depth": 10000 }, "json": true },
    { "name": "objects nested 10000 deep", "nest": { "open": "{\"a\":", "inner": "1", "close": "}", "depth": 10000 }, "json": true },
    { "name": "arrays nested 10001 deep", "nest": { "open": "[", "inner": "", "close": "]", "depth": 10001 }, "json": false },
    { "name": "objects nested 10001 deep", "nest": { "open": "{\"a\":", "inner": "1", "close": "}", "depth": 10001 }, "json": false },
    { "name": "plain text", "in": "hello world", "json": false, "value": "hello world" },
    { "name": "unterminated", "in": "{\"unterminated", "json": false, "value": "{\"unterminated" },
    { "name": "whitespace only", "in": " ", "json": false, "value": " " },
    { "name": "empty", "in": "", "json": false, "value": "" },
    { "name": "trailing comma", "in": "[1,]", "json": false, "value": "[1,]" },
    { "name": "leading zero", "in": "01", "json": false, "value": "01" },
    { "name": "two values", "in": "[1] [2]", "json": false, "value": "[1] [2]" },
    { "name": "truncated literal", "in": "tru", "json": false, "value": "tru" },
    { "name": "short unicode escape", "in": "\"\\u00\"", "json": false, "value": "\"\\u00\"" },
    { "name": "raw tab inside a string", "in": "\"\t\"", "json": false, "value": "\"\t\"" },
    { "name": "control characters", "hex": "0001610a", "json": false, "value": "\u0000\u0001a\n" },
    { "name": "delete character", "hex": "7f", "json": false, "value": "\u007f" },
    { "name": "html and line separator", "in": "<&>\u2028", "json": false, "value": "<&>\u2028" },
    { "name": "byte order mark before an object", "hex": "efbbbf7b7d", "json": false, "value": "\ufeff{}" },
    { "name": "byte order mark alone", "hex": "efbbbf", "json": false, "value": "\ufeff" },
    { "name": "four-byte character", "hex": "f09f9880", "json": false, "value": "\ud83d\ude00" },
    { "name": "invalid byte", "hex": "ff", "json": false, "value": "\ufffd" },
    { "name": "two invalid bytes", "hex": "fffe", "json": false, "value": "\ufffd\ufffd" },
    { "name": "truncated three-byte sequence", "hex": "e282", "json": false, "value": "\ufffd\ufffd" },
    { "name": "truncated sequence between letters", "hex": "61e28262", "json": false, "value": "a\ufffd\ufffdb" },
    { "name": "truncated four-byte sequence", "hex": "f09f98", "json": false, "value": "\ufffd\ufffd\ufffd" },
    { "name": "encoded surrogate", "hex": "eda080", "json": false, "value": "\ufffd\ufffd\ufffd" },
    { "name": "overlong encoding", "hex": "c080", "json": false, "value": "\ufffd\ufffd" },
    { "name": "above U+10FFFF", "hex": "f4908080", "json": false, "value": "\ufffd\ufffd\ufffd\ufffd" },
    { "name": "invalid byte outside a string", "hex": "5bff5d", "json": false, "value": "[\ufffd]" }
  ]
}
